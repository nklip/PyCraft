# Copy to .env and adjust as needed. run.sh does this automatically.

# Names the running environment; surfaced in the page template.
PROFILE=local

# WebSocket endpoint the browser connects back to.
WS_HOST=ws://127.0.0.1:8000

# API key. Costs real money. Protect it from leaks at all costs.
# Leave it as it is to run without one: the claude mode then explains that it
# needs a key instead of calling the model, and every other mode is unaffected.
ANTHROPIC_API_KEY="sk-ant-api03-your-api-key-here"

# The model the claude mode talks to.
CLAUDE_MODEL=claude-haiku-4-5

# Ceiling on one reply. Caps a runaway answer, and with it the cost of a turn.
CLAUDE_MAX_TOKENS=4096