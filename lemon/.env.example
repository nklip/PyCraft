# Copy to .env and adjust as needed. run.sh does this automatically.
#
# Docker Compose reads this file for ${VAR} interpolation in compose.yaml, and
# Django reads it through django-environ, so the database credentials below have
# exactly one definition.

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-for-anything-that-is-not-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL
MYSQL_DATABASE=lemon
MYSQL_USER=mysql_fid
MYSQL_PASSWORD=mysql_fid
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
